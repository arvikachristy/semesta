{
  "name": "three-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": "22.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "node scripts/benchmark-countries.mjs",
    "test:browser": "node scripts/check-countries.mjs",
    "test:browser:idle": "node scripts/check-idle-rendering.mjs"
  },
  "dependencies": {
    "@fontsource/lora": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@supabase/supabase-js": "^2.117.3",
    "interactjs": "^1.10.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.4.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
